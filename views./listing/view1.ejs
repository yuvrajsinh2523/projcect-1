<%layout("layouts/boilerplate.ejs")%>

<body>
<div class="row">
   
<div class="col-8 offset-2">

   <div class="card show-card ">
   <img src="<%=perti.image.url%>" class="card-img-top show-img" alt="...">
   <br>
   <div class="card-body">
    <p class="card-text">
      <b><%=perti.title%></b> </p>
      <br>
     <b>Descriptions:</b>  <%=perti.description%> <br><br>
     <b> Price:</b> &#8377;<%=perti.price.toLocaleString("en-IN")%> <br>
      <b>Location:</b> <%=perti.location%> <br>
      <b>Country:</b> <%=perti.country%>


   </div>
   </div>

</div>

   
</div>
<a href="/show/<%=perti._id%>/edit" class="btn btn-dark">Edit your Details</a><br><br>
<form action="/show/<%=perti._id%>?_method=delete" method="post">
 <button class="btn btn-dark">Delete</button>
</form>

</body>
