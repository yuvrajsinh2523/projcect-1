<%layout("layouts/boilerplate.ejs")%>

    <h3>Edit your information</h3>

    <div class="row">

      <div class="col-8">

         <form action="/show/<%=also._id%>?_method=PUT" method="post">
    <label for="" class="form-label">Change title:</label>
    <input type="text" class="form-control" name="listing[title]" value=<%=also.title%> placeholder="Write title">
    <br>

       <label for="" class="form-label">Enter Image URL:</label>
    <input type="text" class="form-control" name="listing[image]"value=<%=also.image%> placeholder="Enter image url">
    <br>

       <label for="" class="form-label">change Description:</label>
       <br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
    <textarea class="form-control"
    name="llisting[description]" id="" placeholder="Enter description" cols="25" rows="5"><%=also.description%></textarea>
    <br>

       <label for="" class="form-label">Enter price you want:</label>
    <input type="text" class="form-control" name="listing[price]" value=<%=also.price%>  placeholder="Enter price">
    <br>

       <label for="" class="form=label">Enter your location:</label>
    <input type="text" name="listing[location]" class="form-control" value=<%=also.location%>  placeholder="Enter location">
    <br>

       <label for="" class="form-label">Enter Your country name:</label>
    <input type="text" name="listing[country]" class="form-control" value=<%=also.country%>  placeholder="Enter country name">
    <br><br>

    <button class="btn btn-dark edit-btn">Edit</button>
    </form>


      </div>

    </div>
  
