
<% layout("layouts/boilerplate.ejs")%>
<body>
    <br><br>
    <!-- <form action="/show/new" method="get">
        <button>Add New</button>
    </form> -->
    <br><br>

    <div class="row row-cols-lg-3 row-cols-md-3 row-cols-sm-1">

      <%for(let data of Showall){%>

        <a href="/show/<%=data._id%>" class="show-link">
            <div class="card">
   <img src="<%= data.image.url%>" class="card-img-top" alt="data.image" style="height: 22rem;">
    <div class="card-img-overlay"></div>
   <div class="card-body">
     <p class="card-text">
         Title:<%=data.title%>
         <br>
         <b>Price:&#8377;<%=Number(data.price).toLocaleString("en-IN") %></b>
     </p>
   </div>
 </div>

        </a>
   
  <%}%>
    </div>
   
        
        
   
</body>
